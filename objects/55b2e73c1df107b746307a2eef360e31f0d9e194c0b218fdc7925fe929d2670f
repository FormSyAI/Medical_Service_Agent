<!doctype html>
<html lang="{{LANG}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
  <title>{{TITLE}} — FormSy</title>
  <style>
    :root { color-scheme: light dark; font: 16px/1.65 system-ui, sans-serif; }
    body { margin: 0; background: #101827; color: #e6edf7; }
    main { max-width: 960px; margin: auto; padding: 32px 24px; }
    header, section { padding: 24px; margin-bottom: 20px; border: 1px solid #35455d; border-radius: 12px; }
    h1 { font-size: 1.8rem; } h2 { font-size: 1.2rem; color: #91c7ff; }
    p, small, li { overflow-wrap: anywhere; } small { display: block; color: #b0bfd3; }
    li { padding: 8px 0; } strong { margin-right: 8px; } nav a { color: #91c7ff; margin-right: 18px; }
    .notice { border-left: 3px solid #e7b65a; padding-left: 12px; }
    @media (max-width: 600px) { main { padding: 16px 12px; } header, section { padding: 16px; } }
  </style>
</head>
<body>
<main>
  <header>
    <small>FORMSY · DEVELOPMENT REPORT</small>
    <h1>{{TITLE}}</h1>
    <p>{{CONTEXT}}</p><small>{{VERSION}}</small><small>{{META}}</small>
    <p class="notice">{{NOTICE}}</p>
    <nav aria-label="{{NAVIGATION}}"><a href="#findings">{{FINDINGSLINK}}</a><a href="#checks">{{CHECKSLINK}}</a><a href="#limitations">{{LIMITATIONSLINK}}</a></nav>
  </header>
  <section id="findings"><h2>{{FINDINGSHEADING}}</h2><ul>{{FINDINGS}}</ul></section>
  <section id="checks"><h2>{{CHECKSHEADING}}</h2><ul>{{CHECKS}}</ul></section>
  <section id="limitations"><h2>{{LIMITATIONSHEADING}}</h2><ul>{{LIMITATIONS}}</ul></section>
</main>
</body>
</html>
