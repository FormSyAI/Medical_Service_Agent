      "content": "[\n  {\n    \"id\": \"FIX01\",\n    \"title\": \"有效要求、规则及对象版本是否明确？\",\n    \"criterion\": \"满足条件：全部必要基准明确，候选/历史授权/当前解释区分且复核绑定本轮；不满足条件：已证实基准或版本被错误替换且仍以其宣称符合要求；未核查条件：关键验收、范围、目标版本或有效决定缺失\",\n    \"required_evidence\": [\n      \"用户原话/有效决定引用\",\n      \"任务与验收清单\",\n      \"规则版本摘要\",\n      \"目标源码与环境身份\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC01\",\n      \"TC14\"\n    ],\n    \"recheck\": \"新增决定及对象差异，重新确认受影响基准和结论\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  },\n  {\n    \"id\": \"FIX02\",\n    \"title\": \"要求与实质改动是否双向对应？\",\n    \"criterion\": \"满足条件：每个必要验收点有语义成立的改动或有效无需改动依据，每段实质变更有有效任务依据；不满足条件：明确漏实现，或已确认的范围被实质越出；未核查条件：只有平台/时间关系，或缺语义上下文及历史依据\",\n    \"required_evidence\": [\n      \"验收点ID\",\n      \"固定版本实质diff及必要上下文\",\n      \"双向关系及孤立清单\",\n      \"关联依据和人工复核\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC02\"\n    ],\n    \"recheck\": \"逐验收点重新绑定hunk及两端版本；解释孤立和范围变化\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  },\n  {\n    \"id\": \"FIX03\",\n    \"title\": \"修改是否修复原错误且保持必要边界？\",\n    \"criterion\": \"满足条件：原错误因果链被修改，适用合同/负面/兼容边界无已知未处置反例；运行性结论另需实际证据；不满足条件：固定对象和前提下存在可复现或静态可成立的错误路径；未核查条件：只有局部diff、触发条件未知、关键上下文或必要实证缺失\",\n    \"required_evidence\": [\n      \"原错误触发\",\n      \"变更前后代码\",\n      \"必要调用/数据/状态路径\",\n      \"相关合同及边界\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC04\",\n      \"TC05\",\n      \"TC06\",\n      \"TC07\",\n      \"TC09\",\n      \"TC11\"\n    ],\n    \"recheck\": \"对原反例及受影响边界重新检查；按必要性取得运行证据\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  },\n  {\n    \"id\": \"FIX04\",\n    \"title\": \"测试断言是否验证要求及必要负面/回归？\",\n    \"criterion\": \"满足条件：断言能区分原错误与正确行为，必要负面/回归有验证方法，范围经复核；不满足条件：断言明确没有验证原要求，或必要边界被证实遗漏；未核查条件：只有文件/名称/计数而无断言上下文；关键跳过适用性未知\",\n    \"required_evidence\": [\n      \"测试源码及配置\",\n      \"验收点到断言映射\",\n      \"前置/负例/回归设计\",\n      \"mock与skip说明\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC13\",\n      \"TC12\"\n    ],\n    \"recheck\": \"查看新版测试和断言差异，不用执行全绿替代设计复核\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  },\n  {\n    \"id\": \"FIX05\",\n    \"title\": \"必需运行是否在对应版本和环境成立？\",\n    \"criterion\": \"满足条件：每个必验行为有正确版本/环境的有效通过结果；跳过有有效替代；交付绑定足够；不满足条件：实际必验断言失败，或可核实的必要交付条件不成立；未核查条件：仅作者陈述、缺日志、版本/环境不匹配或用mock支持真实声明\",\n    \"required_evidence\": [\n      \"实际命令和完整输出\",\n      \"受测版本/补丁/测试设计\",\n      \"环境和真实/mock分类\",\n      \"必要产物与最终实例身份\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC01\",\n      \"TC14\"\n    ],\n    \"recheck\": \"当前受测对象的原始执行与身份绑定，不继承旧版本同名结果\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  },\n  {\n    \"id\": \"FIX06\",\n    \"title\": \"原问题及影响范围是否复检并满足关闭条件？\",\n    \"criterion\": \"满足条件：当前必验项与问题处置满足关闭门槛，原失败和影响范围复检、独立复核齐全；不满足条件：已证实仍有阻塞反例或缺必要复检/确认却宣称关闭；未核查条件：修复说明存在但复检、版本绑定、关键补证或独立复核不足\",\n    \"required_evidence\": [\n      \"原失败证据\",\n      \"修改版本及影响分析\",\n      \"原问题及回归复检\",\n      \"补证单处置和独立关闭复核\"\n    ],\n    \"version\": \"本地基线 0.2 / 代码修复补充 0.1\",\n    \"source_rules\": [\n      \"TC15\"\n    ],\n    \"recheck\": \"追加新轮次并复核完整关闭清单；新反例重开，旧失败不删除\",\n    \"closure_policy\": \"满足当前必验清单、版本、复检及独立人工复核门槛；风险接受不能转满足\"\n  }\n]\n",
