  decide(req: CommandRequest & {
    readScope: ReadRequest;
    versionId: VersionId;
    segmentIds: "all" | SegmentId[];
    decision: "accept" | "reject" | "withdraw";
    applicability: ApplicabilityConditions;
    userActionRef: string;
    reason: string;
  }): Promise<Result<Adoption>>;
  createCitation(req: ReadRequest & {
    versionId: VersionId;
    segmentId: SegmentId;
    excerptRange: { start: number; end: number };
  }): Promise<Result<Citation>>;
  resolveCitation(req: ReadRequest, citationId: CitationId):
    Promise<Result<{ citation: Citation; originalExcerpt: string; status: CitationStatus }>>;
}
interface Citation {
  citationId: CitationId;
  projectId: ProjectId;
  createdFor: Purpose;
  sourceId: SourceId;
  versionId: VersionId;
  segmentId: SegmentId;
  originalHash: Hash;
  normalizedTextHash: Hash;
  segmentHash: Hash;
  excerptHash: Hash;
  sourceLocator: PrivateSourceLocator;
  page?: number;
  headingPath: string[];
  documentRange: { start: number; end: number; unit: "utf16" };
  authorityAtVersion: Authority;
}
type CitationStatus = "valid" | "superseded" | "review_required"
  | "tombstoned" | "purged" | "grant_revoked" | "broken";
```

审核用途可创建候选引用供讨论，但其用途和采用缺口必须显示。正式上下文创建/解析引用还要验证 `Adoption` 的项目、版本、片段与条件；仅有 citation ID 不是访问凭证。审核引用不能直接传入正式上下文：采用后按正式用途创建引用，保留相同内容绑定与审核引用的关联。引用状态是按当前权限和生命周期计算的结果，历史引用本身保持不可变。

